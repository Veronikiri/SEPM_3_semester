template<typename T>
class subvector {
    T* mas;
    unsigned int top;
    unsigned int capacity;

public:
    subvector() : mas(nullptr), top(0), capacity(0) {}
    ~subvector() {
        if (mas != nullptr) {delete[] mas;}
    }

    subvector(const subvector& other) : top(other.top), capacity(other.capacity) {
        mas = new T[capacity];
        for (unsigned int i = 0; i < top; ++i) {mas[i] = other.mas[i];}
    }

    subvector& operator=(const subvector& other) {
        if (this != &other) {
            if (mas != nullptr) delete[] mas;
            top = other.top;
            capacity = other.capacity;
            mas = new T[capacity];
            for (unsigned int i = 0; i < top; ++i) {mas[i] = other.mas[i];}
        }
        return *this;
    }

    subvector(subvector&& other) noexcept : mas(other.mas), top(other.top), capacity(other.capacity) {
        other.mas = nullptr;
        other.top = 0;
        other.capacity = 0;
    }

    subvector& operator=(subvector&& other) noexcept {
        if (this != &other) {
            if (mas != nullptr) delete[] mas;
            mas = other.mas;
            top = other.top;
            capacity = other.capacity;
            other.mas = nullptr;
            other.top = 0;
            other.capacity = 0;
        }
        return *this;
    }

    bool push_back(const T& d) {
        if (top >= capacity) {
            unsigned int new_capacity = (capacity == 0) ? 1 : capacity * 2;
            T* new_mas = new T[new_capacity];
            if (new_mas == nullptr) {return false;}
            for (unsigned int i = 0; i < top; ++i) {new_mas[i] = mas[i];}
            if (mas != nullptr) {delete[] mas;}
            mas = new_mas;
            capacity = new_capacity;
        }
        mas[top] = d;
        top++;
        return true;
    }

    T pop_back() {
        if (top == 0) {return T{};}
        top--;
        return mas[top];
    }

    bool resize(unsigned int new_capacity) {
        if (new_capacity < top) {top = new_capacity;}
        if (new_capacity == capacity) {return true;}
        T* new_mas = new T[new_capacity];
        if (new_mas == nullptr) {return false;}
        for (unsigned int i = 0; i < top; ++i) {new_mas[i] = mas[i];}
        if (mas != nullptr) {delete[] mas;}
        mas = new_mas;
        capacity = new_capacity;
        return true;
    }

    void shrink_to_fit() {
        if (top == capacity || capacity == 0) {return;}
        if (top == 0) {
            if (mas != nullptr) {delete[] mas;}
            mas = nullptr;
            capacity = 0;
            return;
        }
        T* new_mas = new T[top];
        if (new_mas == nullptr) {return;}
        for (unsigned int i = 0; i < top; ++i) {new_mas[i] = mas[i];}
        if (mas != nullptr) {delete[] mas;}
        mas = new_mas;
        capacity = top;
    }

    void clear() {
        top = 0;
    }
};
